<?xml version="1.0" encoding="utf-8"?>
<!--
    Central NuGet import list (the "props" half) shared by every project in this
    solution that consumes the Windows App SDK / C++/WinRT.

    These are packages.config-style imports, mirroring what the Visual Studio
    "Blank App, Packaged (WinUI 3 in Desktop)" template generates.  Paths are
    resolved relative to THIS file (build\), so they always point at
    <repo>\packages\ no matter whether a project is built via the solution or
    directly with msbuild.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <PlaylistPreviewPackagesDir>$(MSBuildThisFileDirectory)..\packages\</PlaylistPreviewPackagesDir>
    <PlaylistPreviewRootDir>$(MSBuildThisFileDirectory)..\</PlaylistPreviewRootDir>
    <PlaylistPreviewNativeArch Condition="'$(Platform)' == 'Win32'">x86</PlaylistPreviewNativeArch>
    <PlaylistPreviewNativeArch Condition="'$(Platform)' == 'x64'">x64</PlaylistPreviewNativeArch>
    <PlaylistPreviewNativeArch Condition="'$(Platform)' == 'ARM64'">arm64</PlaylistPreviewNativeArch>
  </PropertyGroup>

  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.Windows.SDK.BuildTools.10.0.28000.2705\build\Microsoft.Windows.SDK.BuildTools.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.Windows.SDK.BuildTools.10.0.28000.2705\build\Microsoft.Windows.SDK.BuildTools.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.Windows.CppWinRT.3.0.260818.1\build\native\Microsoft.Windows.CppWinRT.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.Windows.CppWinRT.3.0.260818.1\build\native\Microsoft.Windows.CppWinRT.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.2.5.1\build\native\Microsoft.WindowsAppSDK.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.2.5.1\build\native\Microsoft.WindowsAppSDK.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.WinUI.2.3.9\build\native\Microsoft.WindowsAppSDK.WinUI.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.WinUI.2.3.9\build\native\Microsoft.WindowsAppSDK.WinUI.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Widgets.2.0.5\build\native\Microsoft.WindowsAppSDK.Widgets.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Widgets.2.0.5\build\native\Microsoft.WindowsAppSDK.Widgets.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Search.2.5.5\build\native\Microsoft.WindowsAppSDK.Search.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Search.2.5.5\build\native\Microsoft.WindowsAppSDK.Search.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Runtime.2.5.1\build\native\Microsoft.WindowsAppSDK.Runtime.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Runtime.2.5.1\build\native\Microsoft.WindowsAppSDK.Runtime.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.ML.2.1.94\build\native\Microsoft.WindowsAppSDK.ML.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.ML.2.1.94\build\native\Microsoft.WindowsAppSDK.ML.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.AI.2.5.5\build\native\Microsoft.WindowsAppSDK.AI.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.AI.2.5.5\build\native\Microsoft.WindowsAppSDK.AI.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Foundation.2.3.12\build\native\Microsoft.WindowsAppSDK.Foundation.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Foundation.2.3.12\build\native\Microsoft.WindowsAppSDK.Foundation.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.InteractiveExperiences.2.1.9\build\native\Microsoft.WindowsAppSDK.InteractiveExperiences.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.InteractiveExperiences.2.1.9\build\native\Microsoft.WindowsAppSDK.InteractiveExperiences.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.DWrite.2.1.0\build\Microsoft.WindowsAppSDK.DWrite.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.DWrite.2.1.0\build\Microsoft.WindowsAppSDK.DWrite.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Base.2.0.4\build\native\Microsoft.WindowsAppSDK.Base.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Base.2.0.4\build\native\Microsoft.WindowsAppSDK.Base.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.Windows.SDK.BuildTools.MSIX.1.7.251221100\build\Microsoft.Windows.SDK.BuildTools.MSIX.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.Windows.SDK.BuildTools.MSIX.1.7.251221100\build\Microsoft.Windows.SDK.BuildTools.MSIX.props')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.Windows.AI.MachineLearning.2.1.74\build\native\Microsoft.Windows.AI.MachineLearning.props"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.Windows.AI.MachineLearning.2.1.74\build\native\Microsoft.Windows.AI.MachineLearning.props')" />

</Project>
