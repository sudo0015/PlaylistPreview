  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Runtime.2.5.1\build\native\Microsoft.WindowsAppSDK.Runtime.targets"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Runtime.2.5.1\build\native\Microsoft.WindowsAppSDK.Runtime.targets')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Search.2.5.5\build\native\Microsoft.WindowsAppSDK.Search.targets"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Search.2.5.5\build\native\Microsoft.WindowsAppSDK.Search.targets')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Widgets.2.0.5\build\native\Microsoft.WindowsAppSDK.Widgets.targets"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.WindowsAppSDK.Widgets.2.0.5\build\native\Microsoft.WindowsAppSDK.Widgets.targets')" />
