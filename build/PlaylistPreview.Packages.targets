<?xml version="1.0" encoding="utf-8"?>
<!--
    Central NuGet import list (the "targets" half) shared by every project in this
    solution that consumes the Windows App SDK / C++/WinRT.  Import AFTER
    Microsoft.Cpp.targets.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.Web.WebView2.1.0.3719.77\build\native\Microsoft.Web.WebView2.targets"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.Web.WebView2.1.0.3719.77\build\native\Microsoft.Web.WebView2.targets')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.Windows.AI.MachineLearning.2.1.74\build\native\Microsoft.Windows.AI.MachineLearning.targets"
          Condition="Exists('$(PlaylistPreviewPackagesDir)Microsoft.Windows.AI.MachineLearning.2.1.74\build\native\Microsoft.Windows.AI.MachineLearning.targets')" />
  <Import Project="$(PlaylistPreviewPackagesDir)Microsoft.Windows.SDK.BuildTools.MSIX.1.7.251221100\build\Microsoft.Windows.SDK.BuildTools.MSIX.targets"
